# mctl-portal environment variables for production deployment
# Copy this file to .env and fill in values for your org

# App URLs
APP_BASE_URL=https://app.example.com
BACKEND_BASE_URL=https://app.example.com

# Organization
ORG_NAME=your-github-org

# GitOps repository
GITOPS_REPO_ORG=your-github-org
GITOPS_REPO_NAME=mctl-gitops

# Argo Workflows
ARGO_WORKFLOWS_URL=https://workflows.example.com

# Database (required)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=backstage
POSTGRES_PASSWORD=

# GitHub Auth (required)
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# GitHub App (required for integrations)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Vault (optional)
VAULT_ADDR=https://vault.example.com
VAULT_TOKEN=

# Kubernetes (for resource usage plugin)
K8S_SERVICE_ACCOUNT_TOKEN=

# Platform config
PLATFORM_DOMAIN=example.com
PLATFORM_DOMAIN_ALT=example.io
ARGOCD_BASE_URL=https://argocd.example.com/applications/argocd
ARGO_WORKFLOWS_BASE_URL=https://workflows.example.com
CONTAINER_REGISTRY=ghcr.io/your-org

# Tenant management
BACKSTAGE_LANDING_TOKEN=

# Custom domains (custom-domains-backend gateway to mctl-api's registry)
MCTL_API_URL=https://api.mctl.ai
MCTL_API_TOKEN=

# Work items (work-items-backend, app-config.production.yaml
# workItems.surfaceToken). The token of mctl-api's non-admin `surface:portal`
# principal (mctl-api#350), NOT the admin MCTL_API_TOKEN above: the plugin
# never falls back to it. Unset, every work-item data route answers 503
# work_items_unconfigured.
MCTL_SURFACE_PORTAL_TOKEN=

# Static token mctl-api sends as a Bearer when it calls into this backend
# (backend.auth.externalAccess, subject mctl-api, restricted to
# custom-domains). Previously missing from this file despite being
# referenced in app-config.production.yaml.
BACKSTAGE_TOKEN=
